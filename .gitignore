.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
*~

# --- Systemes de fichiers ---
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
